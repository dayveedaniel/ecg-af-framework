# Env values for running pipeline scripts from the host machine.

# S3 / MinIO (host ports mapped by docker compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# PostgreSQL (host port mapped by docker compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecg_metadata
POSTGRES_USER=ecg_pipeline
POSTGRES_PASSWORD=postgres

# Spark (if/when used)
SPARK_MASTER=local[*]
