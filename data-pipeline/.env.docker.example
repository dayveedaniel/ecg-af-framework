# Env values for services running inside `data-pipeline/docker-compose.yaml`.

# S3 / MinIO (docker network hostnames)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# PostgreSQL (docker network hostnames)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecg_metadata
POSTGRES_USER=ecg_pipeline
POSTGRES_PASSWORD=postgres

# Airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
# Local dev only. Change this if you expose Airflow outside localhost.
AIRFLOW__WEBSERVER__SECRET_KEY=dev-only-change-me
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Spark (if/when used)
SPARK_MASTER=local[*]
